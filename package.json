{
  "name": "rfw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "cd ./glTF-Sample-Renderer && npm install && npm run build",
    "postinstall": "cp ./glTF-Sample-Renderer/dist/libs/*.wasm ./glTF-Sample-Renderer/dist/ && cp ./glTF-Sample-Renderer/dist/libs/* ./public/libs/",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "images": "cp -r 'glTF-Render-Fidelity-Generator/test/goldens/.' 'public/images/goldens'",
    "thumbnail": "node src/scripts/create_thumbnails.mjs",
    "metadata": "node src/scripts/extract_model_metadata.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/model-viewer": "^4.3.1",
    "@khronosgroup/gltf-viewer": "./glTF-Sample-Renderer",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "fuse.js": "^7.5.0",
    "gl-matrix": "^3.4.4",
    "image-js": "^1.7.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "three": "^0.183.0",
    "three-gpu-pathtracer": "^0.0.24"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/showdown": "^2.0.6",
    "@types/three": "^0.183.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "showdown": "^2.1.0",
    "typescript": "^7.0.2"
  }
}
